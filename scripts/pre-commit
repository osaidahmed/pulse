#!/usr/bin/env bash
# Pre-commit hook. Runs `cargo fmt --check` and `cargo clippy` and blocks the
# commit if either reports a problem.
#
# Install:
#   ln -s ../../scripts/pre-commit .git/hooks/pre-commit
#
# Bypass for a single commit:
#   git commit --no-verify ...

set -uo pipefail

if ! git diff --cached --name-only --diff-filter=ACMR | grep -qE '\.rs$|^Cargo\.(toml|lock)$'; then
  exit 0
fi

if ! command -v cargo >/dev/null 2>&1; then
  echo "pre-commit: cargo not found on PATH; skipping checks" >&2
  exit 0
fi

if ! cargo fmt --check; then
  echo "pre-commit: formatting check failed — run 'cargo fmt' to fix" >&2
  exit 1
fi

exec cargo clippy --quiet -- -D warnings
